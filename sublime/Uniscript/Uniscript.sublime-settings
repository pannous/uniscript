{
	// path of the uniscript converter; empty: the newest cargo build when the package links into a checkout, else
	// search PATH and ~/.cargo/bin
	// (cargo install --git https://github.com/pannous/uniscript)
	"binary": "",

	// replace a <:tag> with its Unicode as soon as its > is typed:
	// true, false, or "header" for files starting with <: (the uniscript header <:uniscript version="…">)
	"convert_while_typing": "header",

	// while a <: or \: tag is typed, the other packages' completions (All Autocomplete, LSP, …) stay quiet
	"only_uniscript_completions_in_tags": true,

	// what choosing a name in the completion list (or Tab on a typed name) leaves: "character" (α, ≝) or "name" (<:alpha>)
	"completion_inserts": "character"
}
