	vertical-kana-repeat-with-voiced-sound-mark-upper-half: "〴"
	vertical-kana-repeat-mark-lower-half: "〵"
	circled-postal-mark: "〶"
	ideographic-telegraph-line-feed-separator-symbol: "〷"
	hangzhou-numeral-ten: "〸"
	hangzhou-numeral-twenty: "〹"
	hangzhou-numeral-thirty: "〺"
	vertical-ideographic-iteration-mark: "〻"
	masu-mark: "〼"
	part-alternation-mark: "〽"
	ideographic-variation-indicator: "〾"
	ideographic-half-fill-space: "〿"
