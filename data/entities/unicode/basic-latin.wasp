// Uniscript entities: unicode/basic-latin.wasp, part of data/entities/ (the sections are explained in uniscript.wasp)

names {
	space: " "
	exclamation-mark: "!"
	quotation-mark: "\""
	number-sign: "#"
	dollar-sign: "$"
	percent-sign: "%"
	ampersand: "&"
	apostrophe: "'"
	left-parenthesis: "("
	right-parenthesis: ")"
	asterisk: "*"
	plus-sign: "+"
	comma: ","
	hyphen-minus: "-"
	full-stop: "."
	solidus: "/"
	digit-zero: "0"
	digit-one: "1"
	digit-two: "2"
	digit-three: "3"
	digit-four: "4"
	digit-five: "5"
	digit-six: "6"
	digit-seven: "7"
	digit-eight: "8"
	digit-nine: "9"
	colon: ":"
	semicolon: ";"
	less-than-sign: "<"
	equals-sign: "="
	greater-than-sign: ">"
	question-mark: "?"
	commercial-at: "@"
	latin-capital-letter-a: "A"
	latin-capital-letter-b: "B"
