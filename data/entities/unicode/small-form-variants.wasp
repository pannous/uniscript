// Uniscript entities: unicode/small-form-variants.wasp, part of data/entities/ (the sections are explained in uniscript.wasp)

names {
	small-comma: "﹐"
	small-ideographic-comma: "﹑"
	small-full-stop: "﹒"
	small-semicolon: "﹔"
	small-colon: "﹕"
	small-question-mark: "﹖"
	small-exclamation-mark: "﹗"
	small-em-dash: "﹘"
	small-left-parenthesis: "﹙"
	small-right-parenthesis: "﹚"
	small-left-curly-bracket: "﹛"
	small-right-curly-bracket: "﹜"
	small-left-tortoise-shell-bracket: "﹝"
	small-right-tortoise-shell-bracket: "﹞"
	small-number-sign: "﹟"
	small-ampersand: "﹠"
	small-asterisk: "﹡"
	small-plus-sign: "﹢"
	small-hyphen-minus: "﹣"
	small-less-than-sign: "﹤"
	small-greater-than-sign: "﹥"
	small-equals-sign: "﹦"
	small-reverse-solidus: "﹨"
	small-dollar-sign: "﹩"
	small-percent-sign: "﹪"
	small-commercial-at: "﹫"
}
