use uniscript
ok = uniscript("<:greek> athos <:/greek>") == "αθος"
ok = ok and uniscript("<:greek> a b g d <:/greek>") == "α β γ δ"
ok = ok and uniscript("<:fracture> A b c <:>") == "𝔄 𝔟 𝔠"
ok = ok and uniscript("<:greek> filosofia kosmos<:/greek>") == "φιλοσοφια κοσμος"
ok = ok and uniscript("<:greek>\nkosmos\t<:/greek>") == "κοσμος"
ok = ok and uniscript("<:greek> a \\:03B2 <:/greek>") == "α β"
ok = ok and uniscript("<:greek>  athos  <:/greek>") == " αθος "
ok = ok and uniscript("<:greek>\r\nkosmos\r\n<:/greek>") == "κοσμος"
ok = ok and uniscript("<:greek>\nfilosofia\nkosmos\n<:/greek>") == "φιλοσοφια\nκοσμος"
ok = ok and uniscript("x <:greek> a <:/greek> y") == "x α y"
ok
