<Project Sdk="Microsoft.NET.Sdk">
	<!-- NuGet package Uniscript: the Rust crate's C ABI (c/uniscript.h) via P/Invoke, one native library per runtime
	     identifier from `make -C c/ffi natives` packed in runtimes/<rid>/native -->
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>Pannous</RootNamespace>
		<AssemblyName>Uniscript</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsAotCompatible>true</IsAotCompatible>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<Version>1.0.0</Version>
		<PackageId>Uniscript</PackageId>
		<Authors>pannous</Authors>
		<Description>ASCII names for Unicode text and back: &lt;:alpha&gt; → α, &lt;:fracture A&gt; → 𝔄. Wraps the Rust reference implementation.</Description>
		<PackageTags>unicode;uniscript;latex;math;symbols;hieroglyphs;cuneiform</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/pannous/uniscript</PackageProjectUrl>
		<RepositoryUrl>https://github.com/pannous/uniscript</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<NativesDirectory>$(MSBuildThisFileDirectory)../../c/ffi/build/natives/</NativesDirectory>
	</PropertyGroup>
	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="/" />
		<None Include="$(NativesDirectory)**/*" Pack="true" PackagePath="runtimes/%(RecursiveDir)native/%(Filename)%(Extension)" />
	</ItemGroup>
	<Target Name="RequireNatives" BeforeTargets="GenerateNuspec">
		<Error Condition="!Exists('$(NativesDirectory)win-x64/uniscript.dll')" Text="no native libraries: run make -C c/ffi natives" />
	</Target>
</Project>
