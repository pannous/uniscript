<Project Sdk="Microsoft.NET.Sdk">
	<!-- the shared cases js/test/cases.json against the library, with this machine's native library from `make -C c/ffi natives` -->
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<RootNamespace>UniscriptTests</RootNamespace>
		<HostNative>$(MSBuildThisFileDirectory)../../c/ffi/build/natives/$(NETCoreSdkRuntimeIdentifier)/</HostNative>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageReference Include="xunit.v3" Version="4.0.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="../src/Uniscript.csproj" />
		<None Include="../../js/test/cases.json" CopyToOutputDirectory="PreserveNewest" />
		<None Include="$(HostNative)*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<!-- a native library built before the last change of the Rust sources or the index fails the shared cases: say so -->
	<Target Name="RequireCurrentNative" BeforeTargets="Build">
		<ItemGroup>
			<HostNativeLibrary Include="$(HostNative)*" />
			<NativeInput Include="$(MSBuildThisFileDirectory)../../src/*.rs;$(MSBuildThisFileDirectory)../../data/entities.idx" />
		</ItemGroup>
		<PropertyGroup>
			<HostNativeTicks>@(HostNativeLibrary->'%(ModifiedTime)')</HostNativeTicks>
			<HostNativeTicks Condition="'$(HostNativeTicks)' != ''">$([System.DateTime]::Parse('$(HostNativeTicks)').Ticks)</HostNativeTicks>
		</PropertyGroup>
		<Error Condition="'$(HostNativeTicks)' != '' And $([System.DateTime]::Parse('%(NativeInput.ModifiedTime)').Ticks) &gt; $(HostNativeTicks)"
		       Text="$(HostNative) is older than %(NativeInput.Identity): run make -C c/ffi natives" />
	</Target>
</Project>
