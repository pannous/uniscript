// Uniscript (wiki/uniscript.md): ASCII names for Unicode text, and back
//   uniscript("\:alpha <:fracture A/> \:infinity")  →  "α 𝔄 ∞"
//   unicode_to_uniscript("α 𝔄 ∞")                   →  "\:alpha \:fracture-A \:infinity"
//   explicit("<:alpha> <:greek athos>")            →  "\:alpha \:greek-athos"  (a bare inline tag warns: it looks like an opener)
// The wasp implementation, run by warp (github.com/pannous/warp): `use uniscript` there fetches this repository as a package.
// Names and block types live in data/entities/*.wasp; this reads their binary index data/entities.idx, whose format
// src/index.rs documents: tables of 20-byte records sorted by a hash of the key.

version 1.0.5  // the package version, as in Cargo.toml: `use uniscript >= 1.0` checks it
const uniscript_index = read(module_directory + "/data/entities.idx")
const names_table = 0     // name → text, block entries as "block operand"
const chars_table = 1     // text → its uniscript
const suffixes_table = 2  // suffix control → block type
const meta_table = 4      // meta key → its CSS template: color, font, lang
const record_size = 20
const hash_multiplier = 31
const hash_modulus = 4294967296
const uniscript_version = "https://uniscript.org/v1"  // the version this reads, declared by the header <:uniscript version="…">
const header_open = "<:uniscript"
const version_attribute = "version="
const max_hex_digits = 8
const min_bare_hex_digits = 4     // bare hex (\:1F60D) and \U1F60D need 4 digits, so a mistyped short name stays unknown
const max_code_point = 1114111    // 10FFFF
const first_surrogate = 55296     // D800
const last_surrogate = 57343      // DFFF
const hex_digits = "0123456789ABCDEF"
const max_operand_words = 8      // the most words one operand spans: <:egyptian man with hand to mouth>
const warned_code_point = 64976  // U+FDD0, a noncharacter: the mark unsupported() leaves in converted text
const readings_key = "*readings" // a block whose words split into whole readings (chinese shihan → shi han), not letters
// algorithmic Unicode names (UAX #44 NR1/NR2, src/algorithmic_names.rs): no index entries, derived from the code point
const hex_named_prefixes = ["cjk-unified-ideograph-", "cjk-compatibility-ideograph-", "tangut-ideograph-", "khitan-small-script-character-", "nushu-character-", "egyptian-hieroglyph-"]
// the ranges each prefix names, as triples prefix index, first, last (Unicode 16.0.0 blocks)
const hex_named_ranges = [0, 0x3400, 0x4DBF, 0, 0x4E00, 0x9FFF, 0, 0x20000, 0x2A6DF, 0, 0x2A700, 0x2B73F, 0, 0x2B740, 0x2B81F, 0, 0x2B820, 0x2CEAF, 0, 0x2CEB0, 0x2EBEF, 0, 0x2EBF0, 0x2EE5F, 0, 0x30000, 0x3134F, 0, 0x31350, 0x323AF, 1, 0xF900, 0xFAFF, 1, 0x2F800, 0x2FA1F, 2, 0x17000, 0x187FF, 2, 0x18D00, 0x18D7F, 3, 0x18B00, 0x18CFF, 4, 0x1B170, 0x1B2FF, 5, 0x13460, 0x143FF]
const tangut_component = "tangut-component-"  // numbered in decimal: tangut-component-001 is U+18800
const first_tangut_component = 0x18800
const tangut_components = 768
const hangul_syllable = "hangul-syllable-"
const first_hangul_syllable = 0xAC00
// the jamo short names of a syllable's leading consonant, vowel and trailing consonant
const hangul_leading = ["g", "gg", "n", "d", "dd", "r", "m", "b", "bb", "s", "ss", "", "j", "jj", "c", "k", "t", "p", "h"]
const hangul_vowels = ["a", "ae", "ya", "yae", "eo", "e", "yeo", "ye", "o", "wa", "wae", "oe", "yo", "u", "weo", "we", "wi", "yu", "eu", "yi", "i"]
const hangul_trailing = ["", "g", "gg", "gs", "n", "nj", "nh", "d", "l", "lg", "lm", "lb", "ls", "lt", "lp", "lh", "m", "b", "bs", "s", "ss", "ng", "j", "c", "k", "t", "p", "h"]

// ---- the index -------------------------------------------------------------------------------------------------

u32(offset) := byte_at(uniscript_index, offset) + 256 * byte_at(uniscript_index, offset + 1) + 65536 * byte_at(uniscript_index, offset + 2) + 16777216 * byte_at(uniscript_index, offset + 3)

text_hash(key:text) := {
	hash = 0
	i = 0
	while i < key.bytes {
		hash = (hash * hash_multiplier + byte_at(key, i)) % hash_modulus
		i++
	}
	hash
}

// the record of key in table, or -1: binary search for the first record of its hash, then compare the keys
find(table, key:text) := {
	wanted = text_hash(key)
	first = u32(8 + 8 * table)
	count = u32(12 + 8 * table)
	low = 0
	high = count
	while low < high {
		middle = (low + high) >> 1
		if u32(first + middle * record_size) < wanted { low = middle + 1 } else { high = middle }
	}
	found = -1
	while found < 0 and low < count and u32(first + low * record_size) == wanted {
		record = first + low * record_size
		if byte_slice(uniscript_index, u32(record + 4), u32(record + 4) + u32(record + 8)) == key { found = record }
		low++
	}
	found
}

value_of(record) := byte_slice(uniscript_index, u32(record + 12), u32(record + 12) + u32(record + 16))

// the text of an entry, "" when there is none
entry(key:text) := {
	record = find(names_table, key)
	if record >= 0 { value_of(record) } else { "" }
}

is_block(name:text) := find(names_table, name + " ") >= 0

is_group(name:text) := find(names_table, name + " *group") >= 0

is_effect(name:text) := find(names_table, name + " *suffix") >= 0

is_meta_key(name:text) := find(meta_table, name) >= 0

// ---- characters ----------------------------------------------------------------------------------------------

utf8_width(lead) := if lead < 128 {1} else { if lead < 224 {2} else { if lead < 240 {3} else {4} } }

// the script a character needs its own controls for: hieroglyphs (U+13000…) and CJK ideographs (U+2E80…U+9FFF, U+20000…)
script_of(character:text) := {
	lead = byte_at(character, 0)
	second = 0
	if character.bytes > 1 { second = byte_at(character, 1) }
	if lead == 240 and second == 147 { return "egyptian" }
	if (lead == 226 and second >= 186) or (lead >= 227 and lead <= 233) or (lead == 240 and second >= 160 and second <= 179) { return "cjk" }
	""
}

is_name_byte(b) := (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 45 or b == 95

// offset of the first occurrence of byte in text at or after start, else text.bytes
offset_of(text:text, byte, start) := {
	i = start
	while i < text.bytes and byte_at(text, i) != byte { i++ }
	i
}

ascii_lowercased(name:text) := {
	out = ""
	i = 0
	while i < name.bytes {
		b = byte_at(name, i)
		if b >= 65 and b <= 90 { out += byte_slice("abcdefghijklmnopqrstuvwxyz", b - 65, b - 64) } else { out += byte_slice(name, i, i + 1) }
		i++
	}
	out
}

// offset of the first occurrence of part in text at or after start, else text.bytes
offset_of_text(text:text, part:text, start) := {
	i = start
	while i + part.bytes <= text.bytes and byte_slice(text, i, i + part.bytes) != part { i++ }
	if i + part.bytes > text.bytes { return text.bytes }
	i
}

// each byte of text replaced by the text by
byte_replaced(text:text, byte, by:text) := {
	out = ""
	i = 0
	while i < text.bytes {
		found = offset_of(text, byte, i)
		out += byte_slice(text, i, found)
		if found < text.bytes { out += by }
		i = found + 1
	}
	out
}

// spaces become hyphens: <:greek small letter alpha> names greek-small-letter-alpha
hyphenated(name:text) := byte_replaced(name, 32, "-")

// hyphens become spaces: \:egyptian-seated-man reads as <:egyptian seated man>
spaced(name:text) := byte_replaced(name, 45, " ")

// ---- uniscript → Unicode ---------------------------------------------------------------------------------------

// a warning (warp --strict or `use strict`: an error) about a character or combination Unicode has no counterpart for
// with a mark, so a tag knows it warned (a warp function cannot count in a global); uniscript() drops the marks
unsupported(message:text, at) := warning("uniscript: " + message + " at byte " + join([at], "")) + (warned_code_point as char)

// a strict warning is an Error, which warned too
warned(text:text) := is_error(text) or offset_of_text(text, "" + (warned_code_point as char), 0) < text.bytes

// a strict warning stays its Error: warp's byte_slice would read the Error as its message text
unmarked(text:text) := {
	if is_error(text) { return text }
	mark = "" + (warned_code_point as char)
	out = ""
	i = 0
	while i < text.bytes {
		at = offset_of_text(text, mark, i)
		out += byte_slice(text, i, at)
		i = at + mark.bytes
	}
	out
}

// the record of the control a block puts after a character of its script or after any character, -1 for none;
// an empty control means the effect cannot apply to that script
suffix_record(block:text, character:text) := {
	script = script_of(character)
	suffix = -1
	if script.bytes > 0 { suffix = find(names_table, block + " *suffix " + script) }
	if suffix < 0 { suffix = find(names_table, block + " *suffix") }
	suffix
}

// the control of an effect after one character, "" with a warning when it has none for it
effect_suffix(block:text, character:text, at) := {
	suffix = suffix_record(block, character)
	if suffix >= 0 and u32(suffix + 16) > 0 { return value_of(suffix) }
	unsupported(block + " does not apply to " + character, at)
}

// the suffixes of the stacked effect words ("mirror " in <:mirror red A>) for one character
effect_suffixes(effects:text, character:text, at) := {
	out = ""
	i = 0
	while i < effects.bytes {
		end = offset_of(effects, 32, i)
		out += effect_suffix(byte_slice(effects, i, end), character, at)
		i = end + 1
	}
	out
}

// one character in a block: its own entry (greek a → α), else followed by the block's suffix; then the stacked effects;
// a character the block has neither for stays plain, with a warning
styled(block:text, character:text, effects:text, at) := {
	own = find(names_table, block + " " + character)
	if own >= 0 { return value_of(own) + effect_suffixes(effects, character, at) }
	if suffix_record(block, character) < 0 {
		return unsupported("no " + block + " form of " + character, at) + character + effect_suffixes(effects, character, at)
	}
	character + effect_suffix(block, character, at) + effect_suffixes(effects, character, at)
}

// the entry of the next one or two characters in a block (greek th → θ), or the styled first character; with its width
styled_prefix(block:text, characters:text, i, effects:text, at) := {
	width = utf8_width(byte_at(characters, i))
	if i + width < characters.bytes {
		pair = byte_slice(characters, i, i + width + utf8_width(byte_at(characters, i + width)))
		own = find(names_table, block + " " + pair)
		if own >= 0 { return value_of(own) + effect_suffixes(effects, pair, at) }
	}
	styled(block, byte_slice(characters, i, i + width), effects, at)
}

// how many bytes styled_prefix consumed: two characters when the pair has an entry
prefix_width(block:text, characters:text, i) := {
	width = utf8_width(byte_at(characters, i))
	if i + width < characters.bytes {
		pair_width = width + utf8_width(byte_at(characters, i + width))
		if find(names_table, block + " " + byte_slice(characters, i, i + pair_width)) >= 0 { return pair_width }
	}
	width
}

// an entry of a block followed by the suffixes of the stacked effects
own_form(own:text, effects:text, at) := own + effect_suffixes(effects, own, at)

// the forms of the whole readings a word splits into (shihan → 是汉): the fewest pieces, of those the longest first
// piece; "" when it does not split
readings(block:text, word:text, effects:text, at) := {
	// bounds: the character boundaries; fewest, first_end: pieces of the best split from a boundary (-1: none), the
	// boundary its first piece ends at
	bounds = [0]
	fewest = [-1]
	first_end = [0]
	i = 0
	while i < word.bytes {
		i += utf8_width(byte_at(word, i))
		bounds = bounds + [i]
		fewest = fewest + [-1]
		first_end = first_end + [0]
	}
	last = bounds.count - 1
	fewest[last] = 0
	start = last - 1
	while start >= 0 {
		end = last
		while end > start {
			if fewest[end] >= 0 and (fewest[start] < 0 or fewest[end] + 1 < fewest[start]) and find(names_table, block + " " + byte_slice(word, bounds[start], bounds[end])) >= 0 {
				fewest[start] = fewest[end] + 1
				first_end[start] = end
			}
			end--
		}
		start--
	}
	if fewest[0] < 0 { return "" }
	out = ""
	start = 0
	while start < last {
		out += own_form(entry(block + " " + byte_slice(word, bounds[start], bounds[first_end[start]])), effects, at)
		start = first_end[start]
	}
	out
}

// one operand in a block: its own entry (red circle → 🔴, greek eta → η), else each character (or pair: th) of the
// operand, or of the entity it names
operand(block:text, token:text, effects:text, at) := {
	own = find(names_table, block + " " + token)
	if own >= 0 { return own_form(value_of(own), effects, at) }
	if find(names_table, block + " " + readings_key) >= 0 {
		// <:chinese> shihan: whole readings, never letters (nuli is nu li, not n u l i)
		split = readings(block, token, effects, at)
		if split.bytes > 0 { return split }
		return unsupported("no " + block + " form of " + token, at) + token
	}
	characters = token
	named = find(names_table, token)
	if named >= 0 and token.bytes > 1 { characters = value_of(named) }
	out = ""
	i = 0
	while i < characters.bytes {
		out += styled_prefix(block, characters, i, effects, at)
		i += prefix_width(block, characters, i)
	}
	out
}

// whitespace, which a full block keeps as written but for one on each inner side of its tags
is_space(b) := b == 32 or b == 9 or b == 10 or b == 13

// bytes of the one whitespace a block opener eats after it, at byte at (<:greek> athos <:/greek> is αθοσ); \r\n is one
opening_padding(source:text, at) := {
	if at + 1 < source.bytes and byte_at(source, at) == 13 and byte_at(source, at + 1) == 10 { return 2 }
	if at < source.bytes and is_space(byte_at(source, at)) { return 1 }
	0
}

// bytes of the one whitespace a block's closer eats before it, at the end of run
closing_padding(run:text) := {
	if run.bytes >= 2 and byte_at(run, run.bytes - 2) == 13 and byte_at(run, run.bytes - 1) == 10 { return 2 }
	if run.bytes >= 1 and is_space(byte_at(run, run.bytes - 1)) { return 1 }
	0
}

// whether a block closer (<:> or <:/greek>) starts at byte at
closes_block_at(source:text, at) := {
	if at + 2 >= source.bytes or byte_at(source, at) != 60 or byte_at(source, at + 1) != 58 { return false }
	byte_at(source, at + 2) == 62 or byte_at(source, at + 2) == 47
}

// the text inside a full block (<:greek> filosofia kosmos<:/greek>) as written: its whitespace stays, each word is an
// operand; a group block joins its parts
block_text(block:text, text:text, at) := {
	if is_group(block) { return group(block, "", text, at) }
	out = ""
	i = 0
	while i < text.bytes {
		end = i
		while end < text.bytes and not is_space(byte_at(text, end)) { end++ }
		if end > i { out += operand(block, byte_slice(text, i, end), "", at) }
		if end < text.bytes { out += byte_slice(text, end, end + 1) }
		i = end + 1
	}
	out
}

// the first byte from start that is no space
skip_spaces(content:text, start) := {
	i = start
	while i < content.bytes and byte_at(content, i) == 32 { i++ }
	i
}

// the end of the operand of the block that starts at byte start: the longest run of words that names one operand (seated
// man, red crown), else one word; block "" takes one word
operand_end(block:text, content:text, start) := {
	end = offset_of(content, 32, start)
	best = end
	words = 1
	while block.bytes > 0 and words < max_operand_words and skip_spaces(content, end) < content.bytes {
		end = offset_of(content, 32, skip_spaces(content, end))
		words++
		if find(names_table, block + " " + hyphenated(byte_slice(content, start, end))) >= 0 { best = end }
	}
	best
}

// whether the content starts with an operand of the block: <:egyptian red crown> names a sign, red is no effect
starts_operand(block:text, content:text) := {
	start = skip_spaces(content, 0)
	start < content.bytes and find(names_table, block + " " + hyphenated(byte_slice(content, start, operand_end(block, content, start)))) >= 0
}

// the space separated operands of an inline tag, spaces dropped
operands(block:text, content:text, effects:text, at) := {
	out = ""
	i = skip_spaces(content, 0)
	while i < content.bytes {
		end = operand_end(block, content, i)
		out += operand(block, hyphenated(byte_slice(content, i, end)), effects, at)
		i = skip_spaces(content, end)
	}
	out
}

// a part of a group: an operand of the naming block, else the entity it names, else itself
group_part(naming:text, token:text) := {
	part = token
	named = find(names_table, token)
	if named >= 0 and token.bytes > 1 { part = value_of(named) }
	own = find(names_table, naming + " " + token)
	if naming.bytes > 0 and own >= 0 { part = value_of(own) }
	part
}

// a group (above, beside) joins its parts unstyled with the prefix before or the infix between them that the script of the
// first part has; the parts are operands of the naming block (<:egyptian above A1 A2>), else names or text
group(group_name:text, naming:text, content:text, at) := {
	out = ""
	script = ""
	parts = 0
	i = skip_spaces(content, 0)
	while i < content.bytes {
		end = operand_end(naming, content, i)
		word = hyphenated(byte_slice(content, i, end))
		part = group_part(naming, word)
		if parts > 0 and is_group(word) {
			// <:above 宀 beside 电 电>: a group word among the parts groups the parts after it
			out += entry(group_name + " *infix " + script) + entry(group_name + " *open " + script)
			out += group(word, naming, byte_slice(content, end, content.bytes), at) + entry(group_name + " *close " + script)
			end = content.bytes
		} else {
			if parts == 0 {
				script = script_of(part)
				out += entry(group_name + " *prefix " + script)
				if find(names_table, group_name + " *prefix " + script) < 0 and find(names_table, group_name + " *infix " + script) < 0 {
					out += unsupported("no " + group_name + " group of " + part, at)
				}
			} else {
				out += entry(group_name + " *infix " + script)
			}
			out += part
		}
		parts++
		i = skip_spaces(content, end)
	}
	out
}

// the first group among the space separated words, else ""
group_word(words:text) := {
	found = ""
	i = 0
	while i < words.bytes {
		end = offset_of(words, 32, i)
		word = byte_slice(words, i, end)
		if found.bytes == 0 and is_group(word) { found = word }
		i = end + 1
	}
	found
}

// the last of the space separated words that is neither a group nor an effect: the block naming the parts of a group
naming_word(words:text) := {
	found = ""
	i = 0
	while i < words.bytes {
		end = offset_of(words, 32, i)
		word = byte_slice(words, i, end)
		if not is_group(word) and not is_effect(word) { found = word }
		i = end + 1
	}
	found
}

// ---- stacked styles: <:bold italic alpha> 𝜶, <:greek bold a> 𝛂 ---------------------------------------------------------

// the effects (with a suffix control: mirror, red) or else the styles among the space terminated words, space terminated
stacked_words(words:text, effects) := {
	out = ""
	i = 0
	while i < words.bytes {
		end = offset_of(words, 32, i)
		word = byte_slice(words, i, end)
		if word.bytes > 0 and is_effect(word) == effects { out += word + " " }
		i = end + 1
	}
	out
}

// the block and plain operand a character spells back as, "bold a" (𝐚) or "alpha" (α); "" for none
spelling(character:text) := {
	record = find(chars_table, character)
	if record < 0 { return "" }
	form = value_of(record)
	if form.bytes < 3 or byte_slice(form, 0, 2) != "<:" { return "" }
	byte_slice(form, 2, form.bytes - 1)
}

// the block of a spelling ("" for none): bold of "bold a", "" of "alpha"
spelling_block(content:text) := {
	space = offset_of(content, 32, 0)
	if space < content.bytes and is_block(byte_slice(content, 0, space)) { return byte_slice(content, 0, space) }
	""
}

// the operand of a spelling: a of "bold a", alpha of "alpha"
spelling_operand(content:text) := {
	block = spelling_block(content)
	if block.bytes == 0 { return content }
	byte_slice(content, block.bytes + 1, content.bytes)
}

// a block named by the parts (split at hyphens) of the space terminated words, joined in some order: bold + sans + italic
// → sans-bold-italic; prefix holds the parts placed so far; "" for none
combined(prefix:text, parts:text) := {
	if parts.bytes == 0 {
		if is_block(prefix) { return prefix }
		return ""
	}
	i = 0
	while i < parts.bytes {
		end = offset_of(parts, 32, i)
		part = byte_slice(parts, i, end)
		rest = byte_slice(parts, 0, i) + byte_slice(parts, end + 1, parts.bytes)
		joined = part
		if prefix.bytes > 0 { joined = prefix + "-" + part }
		found = combined(joined, rest)
		if found.bytes > 0 { return found }
		i = end + 1
	}
	""
}

// the space terminated words with their hyphenated parts as words, each once: "sans-bold italic " → "sans bold italic "
style_parts(words:text) := {
	out = ""
	spaced_words = byte_replaced(words, 45, " ")
	i = 0
	while i < spaced_words.bytes {
		end = offset_of(spaced_words, 32, i)
		part = byte_slice(spaced_words, i, end)
		if part.bytes > 0 and offset_of_text(" " + out, " " + part + " ", 0) >= out.bytes + 1 { out += part + " " }
		i = end + 1
	}
	out
}

// the form of one character in one more style, "" for none: its own entry, else (greek alpha → α) the style of its operand,
// else the style commuting with the character's own (greek on 𝐚: bold of greek a → 𝛂)
restyled_by(style:text, character:text) := {
	own = find(names_table, style + " " + character)
	if own >= 0 { return value_of(own) }
	content = spelling(character)
	if content.bytes == 0 { return "" }
	block = spelling_block(content)
	plain_operand = spelling_operand(content)
	if block.bytes == 0 { return entry(style + " " + plain_operand) }
	base = plain_operand
	named = find(names_table, plain_operand)
	if named >= 0 and plain_operand.bytes > 1 { base = value_of(named) }
	if base.bytes != utf8_width(byte_at(base, 0)) { return "" }
	base_form = restyled_by(style, base)
	if base_form.bytes == 0 { return "" }
	if base_form == base { return character }
	entry(block + " " + base_form)
}

// the text in the space terminated styles, the last applied first; a style without a form keeps it, with a warning
restyled_by_all(styles:text, text:text, at) := {
	if styles.bytes == 0 { return text }
	end = styles.bytes - 1
	start = end
	while start > 0 and byte_at(styles, start - 1) != 32 { start-- }
	style = byte_slice(styles, start, end)
	rest = byte_slice(styles, 0, start)
	if text.bytes != utf8_width(byte_at(text, 0)) { return restyled_by_all(rest, text, at) }
	form = restyled_by(style, text)
	if form.bytes == 0 { return restyled_by_all(rest, unsupported("no " + style + " form of " + text, at) + text, at) }
	restyled_by_all(rest, form, at)
}

// a character in further styles: in the block combining them with its own style (bold on 𝛼 → bold-italic α), else one
// style after the other
restyled(styles:text, character:text, at) := {
	content = spelling(character)
	if content.bytes > 0 {
		block = spelling_block(content)
		plain_operand = spelling_operand(content)
		base = plain_operand
		named = find(names_table, plain_operand)
		if block.bytes > 0 and named >= 0 and plain_operand.bytes > 1 { base = value_of(named) }
		all = styles
		if block.bytes > 0 { all += block + " " }
		combination = combined("", style_parts(all))
		if combination.bytes > 0 {
			form = find(names_table, combination + " " + base)
			if form >= 0 { return value_of(form) }
		}
	}
	restyled_by_all(styles, character, at)
}

// each character of the plain operands in the styles, followed by the suffixes of the effects; warning marks stay
restyled_operands(styles:text, effects:text, plain:text, at) := {
	mark = "" + (warned_code_point as char)
	out = ""
	i = 0
	while i < plain.bytes {
		width = utf8_width(byte_at(plain, i))
		character = byte_slice(plain, i, i + width)
		if character == mark { out += mark } else { out += restyled(styles, character, at) + effect_suffixes(effects, character, at) }
		i += width
	}
	out
}

// the text of <:content> at byte `at` of the source, or the block it opens (as "<block>"), or "" for a closing tag; an Error when nothing matches
tag(content:text, at) := {
	if content.bytes == 0 or byte_at(content, 0) == 47 { return "" }
	if content.bytes == 1 { return content }
	record = find(names_table, hyphenated(content))
	if record >= 0 { return value_of(record) }
	value = code_point_value(content)
	if value >= 0 { return code_point_text(value, "<:" + content + ">", at) }
	// before the blocks: <:egyptian hieroglyph-13460> is no operand of the egyptian block
	algorithmic = algorithmic_text(content)
	if algorithmic.bytes > 0 { return algorithmic }
	if is_block(content) { return "<" + content + ">" }
	space = offset_of(content, 32, 0)
	if space == content.bytes { space = offset_of(content, 45, 0) }
	if space < content.bytes {
		block = byte_slice(content, 0, space)
		if is_block(block) {
			// <:mirror red A>: effect words stack, the last one takes the operands, the others add their suffixes
			effects = ""
			rest = byte_slice(content, space + 1, content.bytes)
			// a word that starts an operand of the block before it is no block (<:egyptian red crown>)
			next = offset_of(rest, 32, 0)
			while next < rest.bytes and is_block(byte_slice(rest, 0, next)) and (starts_operand(block, rest) == false) {
				effects += block + " "
				block = byte_slice(rest, 0, next)
				rest = byte_slice(rest, next + 1, rest.bytes)
				next = offset_of(rest, 32, 0)
			}
			// <:egyptian above A1 A2>: the other block names the parts of the group
			grouping = group_word(effects + block)
			if grouping.bytes > 0 { return group(grouping, naming_word(effects + block), rest, at) }
			styles = stacked_words(effects, false)
			if styles.bytes == 0 { return operands(block, rest, effects, at) }
			// <:bold italic A>: the other style words restyle the operands of the last
			return restyled_operands(styles, stacked_words(effects, true), operands(block, rest, "", at), at)
		}
	}
	// the case fallback, after the blocks: <:LATIN CAPITAL LETTER ETH> is latin-capital-letter-eth, <:TILDE> tilde
	record = find(names_table, hyphenated(ascii_lowercased(content)))
	if record >= 0 { return value_of(record) }
	unknown_entity(content)
}

unknown_entity(name:text) := error("unknown uniscript entity: " + name)

// ---- explicit inline tags: <:alpha> looks like it opens something, as <:greek> does; \:alpha and <:alpha/> do not --------

// <:font han-japanese>, <:font x lang ja>: meta keys with values only, opening spans
opens_meta(content:text) := {
	words = 0
	keys = 0
	i = skip_spaces(content, 0)
	while i < content.bytes {
		end = offset_of(content, 32, i)
		if words % 2 == 0 and is_meta_key(byte_slice(content, i, end)) { keys++ }
		words++
		i = skip_spaces(content, end)
	}
	words > 0 and words % 2 == 0 and keys * 2 == words
}

// an inline tag's content looks like it opens something; not an escape (<:<>), closer, self-closed tag, block or meta span opener
reads_as_opener(content:text) := {
	if content.bytes <= 1 or byte_at(content, 0) == 47 or byte_at(content, content.bytes - 1) == 47 { return false }
	not is_block(content) and not opens_meta(content)
}

self_closed_form(content:text) := "<:" + content + "/>"

// \:greek-athos of greek athos followed by byte next (-1 at the end), else "": names only, no name byte may follow, hyphens
// only without spaces (\: reads them as spaces), and no meta key, which reads better as a tag (<:color red A/>)
short_form(content:text, next) := {
	names_only = 0
	spaces = 0
	hyphens = 0
	i = 0
	while i < content.bytes {
		b = byte_at(content, i)
		if b == 32 { spaces++ } else { if is_name_byte(b) { names_only++ } }
		if b == 45 { hyphens++ }
		i++
	}
	space = offset_of(content, 32, 0)
	starts_meta = space < content.bytes and is_meta_key(byte_slice(content, 0, space))
	if names_only + spaces < content.bytes or (spaces > 0 and hyphens > 0) or starts_meta or is_name_byte(next) { return "" }
	"\\:" + hyphenated(content)
}

// <:greek> athos <:/greek> of greek athos, else "": a block and one operand (a block keeps the spaces between operands)
block_form(content:text) := {
	space = offset_of(content, 32, 0)
	if space == content.bytes { return "" }
	block = byte_slice(content, 0, space)
	word = byte_slice(content, space + 1, content.bytes)
	if not is_block(block) or offset_of(word, 32, 0) < word.bytes or is_block(word) { return "" }
	"<:" + block + "> " + word + " <:/" + block + ">"
}

// the explicit forms of an inline tag followed by byte next, which convert alike: "a, b or c"
explicit_forms(content:text, next) := {
	short = short_form(content, next)
	block = block_form(content)
	listed = short
	if short.bytes > 0 and block.bytes > 0 { listed += ", " }
	listed += block
	if listed.bytes > 0 { listed += " or " }
	listed + self_closed_form(content)
}

// the byte after offset at, -1 at the end
byte_after(source:text, at) := if at + 1 < source.bytes { byte_at(source, at + 1) } else { 0 - 1 }

// the text of the inline tag <:content> at byte at, followed by byte next: <:…/> self-closes; a bare one that converts without
// a warning warns that it looks like an opening tag, naming its explicit forms
inline_tag(content:text, at, next) := {
	self_closed = content.bytes > 1 and byte_at(content, content.bytes - 1) == 47
	name = content
	if self_closed { name = byte_slice(content, 0, content.bytes - 1) }
	text = tag(name, at)
	if text == unknown_entity(name) { return text }
	if not self_closed and not warned(text) and reads_as_opener(content) {
		text = unsupported("<:" + content + "> looks like an opening tag: write " + explicit_forms(content, next), at) + text
	}
	unmarked(text)
}

// the source with its inline tags in their explicit form: \:alpha where it fits, else <:color #ff8800 A/>; the header stays
explicit(source:text) := {
	i = header_length(source)
	out = byte_slice(source, 0, i)
	while i < source.bytes {
		open = offset_of_text(source, "<:", i)
		close = offset_of(source, 62, open + 2)
		if close >= source.bytes {
			out += byte_slice(source, i, source.bytes)
			i = source.bytes
		} else {
			content = byte_slice(source, open + 2, close)
			out += byte_slice(source, i, open)
			if reads_as_opener(content) {
				form = short_form(content, byte_after(source, close))
				if form.bytes == 0 { form = self_closed_form(content) }
				out += form
			} else { out += byte_slice(source, open, close + 1) }
			i = close + 1
		}
	}
	out
}

// ---- code points: \:1F60D \:U+1F60D \:0x1F60D <:U+1F60D> \U1F60D -------------------------------------------------

// the value of a hex digit byte, else -1
hex_digit(b) := {
	if b >= 48 and b <= 57 { return b - 48 }
	if b >= 65 and b <= 70 { return b - 55 }
	if b >= 97 and b <= 102 { return b - 87 }
	0 - 1
}

// the value of the hex digits source[start..end] with minimum–8 digits, else -1
hex_value(source:text, start, end, minimum) := {
	if end - start < minimum or end - start > max_hex_digits { return (-1) }
	value = 0
	i = start
	while i < end {
		digit = hex_digit(byte_at(source, i))
		if digit < 0 { return (-1) }
		value = value * 16 + digit
		i++
	}
	value
}

is_u(b) := b == 85 or b == 117

// bytes of the prefix U+ u+ 0x 0X U u of a code point token, else 0
code_point_prefix(token:text) := {
	if token.bytes >= 2 and is_u(byte_at(token, 0)) and byte_at(token, 1) == 43 { return 2 }
	if token.bytes >= 2 and byte_at(token, 0) == 48 and (byte_at(token, 1) == 120 or byte_at(token, 1) == 88) { return 2 }
	if token.bytes >= 1 and is_u(byte_at(token, 0)) { return 1 }
	0
}

// the value of a code point token: U+1F60D U1F60D 0x1F60D (1–8 hex digits) or bare 1F60D (4–8), else -1
code_point_value(token:text) := {
	prefix = code_point_prefix(token)
	if prefix > 0 { return hex_value(token, prefix, token.bytes, 1) }
	hex_value(token, 0, token.bytes, min_bare_hex_digits)
}

// U+ and at least 4 upper case hex digits
code_point_name(value) := {
	out = ""
	while value > 0 or out.bytes < 4 {
		digit = value % 16
		out = byte_slice(hex_digits, digit, digit + 1) + out
		value = (value - digit) / 16  // exact: / of integers that do not divide gives a float
	}
	"U+" + out
}

// the character of a code point; an invalid one (surrogate, above 10FFFF) warns and stays written
code_point_text(value, written:text, at) := {
	if value > max_code_point or (value >= first_surrogate and value <= last_surrogate) { return unsupported("invalid code point " + code_point_name(value), at) + written }
	"" + (value as char)
}

// the end of the name token from start; the + of a leading U+ belongs to it
token_end(source:text, start) := {
	end = start
	if end + 1 < source.bytes and is_u(byte_at(source, end)) and byte_at(source, end + 1) == 43 { end += 2 }
	while end < source.bytes and is_name_byte(byte_at(source, end)) { end++ }
	end
}

// the end of \U1F60D whose backslash is at i (4–8 hex digits as a whole token), the only marker without a colon; else -1
unicode_escape_end(source:text, i) := {
	if i + 1 >= source.bytes or byte_at(source, i + 1) != 85 { return (-1) }
	end = token_end(source, i + 2)
	if hex_value(source, i + 2, end, min_bare_hex_digits) < 0 { return (-1) }
	end
}

// offset of the next "<:", "\:" or "\U1F60D" at or after start, else source.bytes
next_marker(source:text, start) := {
	i = start
	while i + 1 < source.bytes {
		b = byte_at(source, i)
		if (b == 60 or b == 92) and byte_at(source, i + 1) == 58 { return i }
		if b == 92 and unicode_escape_end(source, i) >= 0 { return i }
		i++
	}
	source.bytes
}

// bytes of the header <:uniscript version="https://uniscript.org/v1"> at the start of a file and its line break, else 0;
// another version warns
header_length(source:text) := {
	open = header_open.bytes
	if source.bytes <= open or byte_slice(source, 0, open) != header_open { return 0 }
	if byte_at(source, open) != 32 and byte_at(source, open) != 62 { return 0 }
	close = offset_of(source, 62, open)
	if close == source.bytes { return 0 }
	attribute = open + 1
	while attribute + version_attribute.bytes < close and byte_slice(source, attribute, attribute + version_attribute.bytes) != version_attribute { attribute++ }
	value = attribute + version_attribute.bytes + 1
	if value < close {
		version = byte_slice(source, value, offset_of(source, 34, value))
		if version != uniscript_version { unsupported("unsupported uniscript version " + version, 0) }
	}
	end = close + 1
	if end + 1 < source.bytes and byte_at(source, end) == 13 and byte_at(source, end + 1) == 10 { end += 2 } else {
		if end < source.bytes and byte_at(source, end) == 10 { end++ }
	}
	end
}

uniscript(source:text) := {
	out = ""
	block = ""
	i = header_length(source)
	while i < source.bytes {
		next = next_marker(source, i)
		if next > i {
			run = byte_slice(source, i, next)
			if block.bytes > 0 {
				closing = closes_block_at(source, next)
				if closing { run = byte_slice(run, 0, run.bytes - closing_padding(run)) }
				out += unmarked(block_text(block, run, i))
			} else { out += run }
			i = next
		} else {
			escape = unicode_escape_end(source, i)
			if escape >= 0 {
				out += unmarked(code_point_text(hex_value(source, i + 2, escape, min_bare_hex_digits), byte_slice(source, i, escape), i))
				i = escape
			} else { if byte_at(source, i) == 92 {
				end = token_end(source, i + 2)
				name = byte_slice(source, i + 2, end)
				record = find(names_table, name)
				if record >= 0 { out += value_of(record) } else {
					value = code_point_value(name)
					if value >= 0 { out += unmarked(code_point_text(value, byte_slice(source, i, end), i)) } else {
						// not a name: read as the tag with hyphens as spaces
						text = tag(spaced(name), i)
						if text == unknown_entity(spaced(name)) { return unknown_entity(name) }
						out += unmarked(text)
					}
				}
				i = end
			} else {
				close = offset_of(source, 62, i + 2)
				if close == source.bytes { return error("unclosed <: at byte " + byte_slice(source, i, source.bytes)) }
				content = byte_slice(source, i + 2, close)
				at = i
				i = close + 1
				if content.bytes == 0 or byte_at(content, 0) == 47 { block = "" } else {
					if is_block(content) {
						block = content
						i += opening_padding(source, i)
					} else { out += inline_tag(content, at, byte_after(source, close)) }
				}
			} }
		}
	}
	out
}

// ---- algorithmic names: <:CJK UNIFIED IDEOGRAPH-4E00> 一, <:hangul syllable ga> 가, <:TANGUT COMPONENT-001> -------------

// the value of the decimal digits of text, else -1
decimal_value(text:text) := {
	if text.bytes == 0 { return (-1) }
	value = 0
	i = 0
	while i < text.bytes {
		b = byte_at(text, i)
		if b < 48 or b > 57 { return (-1) }
		value = value * 10 + b - 48
		i++
	}
	value
}

// the syllable whose jamo short names spell name: ga is 가, hih is 힣; else ""
hangul_syllable_text(name:text) := {
	leading = 0
	while leading < hangul_leading.count {
		consonant = "" + hangul_leading[leading]  // "" +: a one-letter list item reads back as a codepoint (warp card list-items)
		if starts_with(name, consonant) {
			after_consonant = byte_slice(name, consonant.bytes, name.bytes)
			vowel = 0
			while vowel < hangul_vowels.count {
				vowel_name = "" + hangul_vowels[vowel]
				if starts_with(after_consonant, vowel_name) {
					rest = byte_slice(after_consonant, vowel_name.bytes, after_consonant.bytes)
					trailing = 0
					while trailing < hangul_trailing.count {
						if rest == "" + hangul_trailing[trailing] { return "" + ((first_hangul_syllable + (leading * 21 + vowel) * 28 + trailing) as char) }
						trailing++
					}
				}
				vowel++
			}
		}
		leading++
	}
	""
}

// the code point a hex named prefix names with its hex digits, else -1
hex_named_value(name:text) := {
	prefix = 0
	while prefix < hex_named_prefixes.count {
		if starts_with(name, hex_named_prefixes[prefix]) {
			value = hex_value(name, hex_named_prefixes[prefix].bytes, name.bytes, min_bare_hex_digits)
			i = 0
			while i < hex_named_ranges.count {
				if hex_named_ranges[i] == prefix and value >= hex_named_ranges[i + 1] and value <= hex_named_ranges[i + 2] { return value }
				i += 3
			}
		}
		prefix++
	}
	-1
}

// the character an algorithmic Unicode name stands for, in any case, spaces as hyphens; else ""
algorithmic_text(content:text) := {
	name = hyphenated(ascii_lowercased(content))
	if starts_with(name, hangul_syllable) { return hangul_syllable_text(byte_slice(name, hangul_syllable.bytes, name.bytes)) }
	if starts_with(name, tangut_component) {
		number = decimal_value(byte_slice(name, tangut_component.bytes, name.bytes))
		if number >= 1 and number <= tangut_components { return "" + ((first_tangut_component + number - 1) as char) }
		return ""
	}
	value = hex_named_value(name)
	if value >= 0 { return "" + (value as char) }
	""
}

// ---- Unicode → uniscript ---------------------------------------------------------------------------------------

// one character, and the block types of the suffix controls after it ("" for none): <:mirror red A>, <:mirror red circle>
spelled(character:text, blocks:text) := {
	own = find(chars_table, character)
	if blocks.bytes == 0 {
		if own >= 0 { return value_of(own) }
		return character
	}
	inner = character
	if own >= 0 {
		form = value_of(own)
		inner = byte_slice(form, 2, form.bytes - 1)
	}
	"<:" + blocks + " " + inner + ">"
}

unicode_to_uniscript(text:text) := {
	out = ""
	i = 0
	while i < text.bytes {
		b = byte_at(text, i)
		if (b == 60 or b == 92) and i + 1 < text.bytes and byte_at(text, i + 1) == 58 {
			out += byte_slice(text, i, i + 1) + "<::>"
			i += 2
		} else { if b == 92 and unicode_escape_end(text, i) >= 0 {
			out += "\\<:U>"  // a literal \U1F60D is escaped
			i += 2
		} else {
			width = utf8_width(b)
			character = byte_slice(text, i, i + width)
			i += width
			// suffixes s1 s2 … are spelled "s2 … s1": the last word styles first, the others follow in order
			first = ""
			others = ""
			suffix = 0
			while suffix >= 0 and i < text.bytes {
				next = utf8_width(byte_at(text, i))
				suffix = find(suffixes_table, byte_slice(text, i, i + next))
				if suffix >= 0 {
					if first.bytes == 0 { first = value_of(suffix) } else { others += value_of(suffix) + " " }
					i += next
				}
			}
			out += spelled(character, others + first)
		} }
	}
	explicit(out)
}
