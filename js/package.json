{
	"name": "uniscript",
	"version": "0.1.0",
	"description": "Uniscript ⇄ Unicode: type any Unicode character in plain ASCII and style it. A TypeScript port of the Rust reference.",
	"type": "module",
	"license": "MIT",
	"repository": { "type": "git", "url": "git+https://github.com/pannous/uniscript.git", "directory": "js" },
	"exports": {
		".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
		"./core": { "types": "./dist/core.d.ts", "default": "./dist/core.js" },
		"./entities.idx": "./entities.idx"
	},
	"files": ["dist", "entities.idx"],
	"engines": { "node": ">=22.18" },
	"scripts": {
		"build": "tsc -p .",
		"test": "node --test test/",
		"prepack": "tsc -p . && rm -f entities.idx && cp ../data/entities.idx entities.idx",
		"postpack": "rm entities.idx && ln -s ../data/entities.idx entities.idx"
	}
}
