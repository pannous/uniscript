{
	"name": "@pannous/uniscript",
	"version": "0.2.0",
	"description": "Uniscript ⇄ Unicode: type any Unicode character in plain ASCII and style it. A TypeScript port of the Rust reference.",
	"type": "module",
	"license": "MIT",
	"repository": { "type": "git", "url": "git+https://github.com/pannous/uniscript.git", "directory": "js" },
	"homepage": "https://pannous.com/uniscript/",
	"bugs": "https://github.com/pannous/uniscript/issues",
	"keywords": ["unicode", "uniscript", "entities", "text", "ascii", "latex", "math"],
	"exports": {
		".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
		"./core": { "types": "./dist/core.d.ts", "default": "./dist/core.js" },
		"./entities.idx": "./entities.idx"
	},
	"files": ["dist", "entities.idx"],
	"engines": { "node": ">=22.18" },
	"publishConfig": { "access": "public" },
	"scripts": {
		"build": "tsc -p .",
		"test": "node --test test/",
		"prepack": "tsc -p . && rm -f entities.idx && cp ../data/entities.idx entities.idx",
		"postpack": "ln -sf ../data/entities.idx entities.idx"
	}
}
