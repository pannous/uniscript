		"converts: [uniscript, unicode]: convert(uniscript, warn).text == unicode",
		"quiet: [uniscript, unicode]: converts without any warning",
		"warnCounts: [uniscript, unicode, number of warnings]",
		"roundTrips: [uniscript, unicode]: converts, and toUniscript(unicode) == uniscript",
		"toUniscript: [unicode, uniscript]",
		"unicodeRoundTrips: [unicode]: toUnicode(toUniscript(unicode)) == unicode",
		"warns: [uniscript, unicode, message, at]: mode warn gives unicode and exactly this warning; mode error throws Unsupported with it",
		"errors: [uniscript, kind, detail]: mode warn throws kind (UnknownEntity, Unclosed, InvalidMeta) carrying detail",
		"lenient: [uniscript, text, [messages]]: mode lenient never throws",
		"header: [source, version or null for no header, length in UTF-8 bytes]",
		"html: [uniscript, html, [[message, at]]]: convert (warn), metaRuns, html; the warnings of metaRuns",
		"metaRuns: [tagged, plain text, run count, [[message, at]]]",
		"fonts: [name, lang, first family] or [name, null] for no font style",
